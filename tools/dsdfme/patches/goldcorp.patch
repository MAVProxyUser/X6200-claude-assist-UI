+//GoldCorpHF: what is heard, a line at a time to the descriptor in DSD_STATUS_FD (the SDR daemon's pipe): "SY 0 <frame
+//type>" while a sync is found (at most ten times a second), "EV <slot> <event>" while a call goes on (as it changes, else
+//once a second), "TX <slot> <text>" its text message, as EV. Never waits: the daemon makes the pipe non-blocking, a full one loses the line
+void dsd_status (const char * kind, int slot, const char * text)
+{
+  static int fd = -2;
+  static char last[3][2][512];
+  static long at[3][2];
+  struct timespec ts;
+  char line[600];
+  int k = kind[0] == 'E' ? 1 : kind[0] == 'T' ? 2 : 0, n;
+  long ms;
+
+  if (fd == -2)
+  {
+    const char * e = getenv ("DSD_STATUS_FD");
+    fd = e ? atoi (e) : -1;
+  }
+  if (fd < 0) return;
+  slot &= 1;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  ms = (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+  //a sync said again each 100 ms at most (the daemon wants three within 1.2 s, as noise seldom gives), the rest each second
+  if (strncmp (last[k][slot], text, sizeof(last[k][slot]) - 1) == 0 && ms - at[k][slot] < (k ? 1000 : 100)) return;
+  snprintf (last[k][slot], sizeof(last[k][slot]), "%s", text);
+  at[k][slot] = ms;
+  n = snprintf (line, sizeof(line), "%s %d %s", kind, slot, text);
+  if (n > (int)sizeof(line) - 2) n = (int)sizeof(line) - 2;
+  line[n++] = '\n';
+  if (write (fd, line, n) < 0 && errno == EPIPE) fd = -1;
+}
