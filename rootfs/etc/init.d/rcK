#!/bin/sh
#
# Stop all init scripts in /etc/init.d, executing them in reversed numerical order (buildroot's rcK).
#
# OpenX6X00: with the start trace (x6100-starttrace), as rcS has it: a line before each script, on the card at once,
# so the trace shows how long a power-off takes and where the time goes. The GUI turns the speaker down when the
# power-off starts, the screen is dark from S95gui's stop on.
#
# The X6200's power: its base switches the radio off about 3 s after it gets "s" on /dev/ttyS1, and only while Linux
# is still up then. The build tree's S11radio_daemon sent it at its stop, a second before the end of the shutdown;
# the kernel's own power-off came first, and base 1.0.8 then left the power on (the green XIEGU light, the speaker
# playing) until a timeout of its own, minutes later (1.0.7 had cut it at once). Xiegu's app sends "s" first and
# shuts down after it, which the base's 3 s cut short: the DATA partition was left unclean. So here S11's stop is
# left out, and the "s" goes last: every script stopped, DATA unmounted and the system read-only, Linux waiting for
# the power to go. A plain reboot ends the same way, as it did with S11's stop: the radio switches off. x6x00-reboot
# leaves /run/x6x00-reboot first: then no "s", the base stays on, and Linux restarts with the radio on
#

trace=/usr/sbin/x6100-starttrace
[ -x "$trace" ] || trace=:
"$trace" "power off: stopping the init scripts"
# S95gui's stop starts no base keeper (x6200-base-keeper) then and ends one a stop by hand left: the base is to switch
# the radio off at the "s" below, or stay on for a restart
export X6X00_SHUTDOWN=1

x6200=false
grep -q "xiegu,x6200" /proc/device-tree/compatible 2>/dev/null && [ -c /dev/ttyS1 ] && x6200=true

for i in $(ls -r /etc/init.d/S??*) ;do

     # Ignore dangling symlinks (if any).
     [ ! -f "$i" ] && continue

     if $x6200 && [ "${i##*/}" = S11radio_daemon ]; then
          "$trace" "S11radio_daemon stop: its s to the base comes last"
          continue
     fi
     "$trace" "${i##*/} stop"
     case "$i" in
	*.sh)
	    # Source shell script for speed.
	    (
		trap - INT QUIT TSTP
		set stop
		. $i
	    )
	    ;;
	*)
	    # No sh extension, so fork subprocess.
	    $i stop
	    ;;
    esac
done
"$trace" "init scripts stopped"

reboot=false
[ -e /run/x6x00-reboot ] && reboot=true

if $x6200; then
    # The last line the trace can have: once DATA is unmounted it has nowhere to go. One more after it says DATA
    # was busy, and by what
    if $reboot; then
        "$trace" "restart (x6x00-reboot): DATA unmounted, the system read-only, the base kept on, no s"
    else
        "$trace" "the base's power off: DATA unmounted, the system read-only, then s to the base"
    fi
    sync
    if ! umount /mnt 2>/dev/null; then
        "$trace" "DATA busy (pids $(fuser -m /mnt 2>/dev/null)): read-only instead"
        sync
        mount -o remount,ro /mnt 2>/dev/null
    fi
    mount -o remount,ro / 2>/dev/null
    sync
    # The base cuts the power about 3 s after it. Now and then it does not act on it: two POWER holds of three
    # left the radio on (2026-11-15, 04:46 and 07:46; 05:50 went off), each trace the same to the second, the base
    # at 1.0.8, play mode off the last time. So it is said again while Linux waits for the power to go, 4 s apart
    # (more than the base's 3 s, so a second "s" never comes during a cut it has begun), till the power goes: up to
    # 15 times, a minute. Still here after that, the shutdown goes on as before. A restart sends none
    if ! $reboot; then
        stty -F /dev/ttyS1 1152000
        k=0
        while [ $k -lt 15 ]; do
            echo s > /dev/ttyS1
            sleep 4
            k=$((k + 1))
        done
    fi
fi

# The X6100's restart (x6x00-reboot): its base switches the radio off when the processor resets, so the kernel on the
# SD card, loaded with kexec there, is jumped to with the processor not reset. The WiFi, the MUSB controller, the
# display and PLL-MIPI left as a power-on finds them (below), DATA unmounted and the system read-only, as a power-off
# leaves them. kexec -e returns only when it failed: then the plain reboot (the radio off)
if ! $x6200 && $reboot && [ -e /run/x6x00-kexec ] && [ "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1 ]; then
    "$trace" "restart (x6x00-reboot): kexec into the SD card's kernel, the processor not reset"
    # x6x00-reboot --state: the clocks and the display as this kernel leaves them, beside a power-on start's
    state=:
    [ -e /run/x6x00-kexec-state ] && [ -x /usr/sbin/x6x00-kexec-state ] && state=/usr/sbin/x6x00-kexec-state
    $state /mnt/app_logs/kexec_state_running.txt --display
    # The WiFi chip (USB, on the MUSB port) off, and the MUSB controller put in reset by its driver's unbind, so the next
    # kernel finds both as a power-on does: the chip off at the kexec start alone was not enough (2026-11-19 21:43: an
    # "unhandled DISCONNECT transition (a_idle)" as the MUSB driver loaded, then no usb 3-1 when the GUI powered it)
    gpioset gpiochip0 5=1 2>/dev/null && w=off || w="not switched: gpioset failed"
    sleep 1
    if [ -e /sys/bus/platform/drivers/musb-sunxi/1c19000.usb ]; then
        echo 1c19000.usb > /sys/bus/platform/drivers/musb-sunxi/unbind 2>/dev/null
        u=$([ -e /sys/bus/platform/drivers/musb-sunxi/1c19000.usb ] && echo "still bound" || echo "unbound, in reset")
    else
        u="not bound"
    fi
    "$trace" "restart (x6x00-reboot): the WiFi chip's power $w, the MUSB controller $u"
    # The display stopped as its driver stops it, the controller's resets asserted, as a power-on finds it: left
    # running into the next kernel it gave no vblank (2026-11-19: "flip_done timed out" at every frame, 10 s each, the
    # first modeset 64 s, which held up the deferred probes, the SD card and USB among them, and no picture)
    if [ -e /sys/bus/platform/drivers/sun4i-drm/display-engine ]; then
        echo display-engine > /sys/bus/platform/drivers/sun4i-drm/unbind 2>/dev/null
        "$trace" "restart (x6x00-reboot): the display stopped (sun4i-drm unbound: $([ -e /sys/bus/platform/drivers/sun4i-drm/display-engine ] && echo still bound || echo done))"
    fi
    # The pixel clock. kexec leaves the clock unit as it is: PLL-MIPI and the LCD clock still at the panel's 27.5 MHz.
    # The next kernel's TCON comes out of its reset with its own dot-clock divider at 0, sun4i_dclk reads that as 1,
    # finds 27.5 MHz already, and clk_set_rate(27.5 MHz) then changes nothing and writes nothing: no dot clock, no
    # vblank, the 10 s flip_done waits and the 64 s stall (2026-11-19 22:02: TCON0 0x044 0x80000000 against a
    # power-on's 0x80000001; the 1 written by hand started the line counter and ended the timeouts). So PLL-MIPI's M
    # (bits 3:0) is moved while the PLL is off (its user unbound just above): the next kernel computes another rate,
    # sets the clocks, and writes the divider, as at a power-on
    v=$(devmem 0x01c20040 32 2>/dev/null)
    if [ -n "$v" ] && [ $((v & 0x80000000)) = 0 ]; then
        if [ $((v & 0xf)) = 0 ]; then m=1; else m=0; fi
        devmem 0x01c20040 32 "$(printf 0x%08x $(( (v & ~0xf) | m )))"
        "$trace" "restart (x6x00-reboot): PLL-MIPI $v -> $(devmem 0x01c20040 32), its rate other than the panel's for the next kernel"
    else
        "$trace" "restart (x6x00-reboot): PLL-MIPI left as it is (${v:-unread}: on, or devmem missing)"
    fi
    # What the next kernel inherits, the clocks alone (--state)
    $state /mnt/app_logs/kexec_state_handover.txt
    dmesg > /mnt/app_logs/dmesg_before_kexec.txt 2>/dev/null     # this kernel's last words (x6x00-reboot --kexec)
    sync
    if ! umount /mnt 2>/dev/null; then
        sync
        mount -o remount,ro /mnt 2>/dev/null
    fi
    mount -o remount,ro / 2>/dev/null
    sync
    /usr/sbin/kexec -e
fi
