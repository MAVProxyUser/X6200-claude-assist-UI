#!/bin/sh
#
# Stop all init scripts in /etc/init.d, executing them in reversed numerical order (buildroot's rcK).
#
# OpenX6X00: with the start trace (x6100-starttrace), as rcS has it: a line before each script, on the card at once,
# so the trace shows how long a power-off takes and where the time goes. The GUI turns the speaker down when the
# power-off starts, the screen is dark from S95gui's stop on.
#
# The X6200's power: its base switches the radio off about 3 s after it gets "s" on /dev/ttyS1, and only while Linux
# is still up then. The build tree's S11radio_daemon sent it at its stop, a second before the end of the shutdown;
# the kernel's own power-off came first, and base 1.0.8 then left the power on (the green XIEGU light, the speaker
# playing) until a timeout of its own, minutes later (1.0.7 had cut it at once). Xiegu's app sends "s" first and
# shuts down after it, which the base's 3 s cut short: the DATA partition was left unclean. So here S11's stop is
# left out, and the "s" goes last: every script stopped, DATA unmounted and the system read-only, Linux waiting for
# the power to go. A reboot ends the same way, as it did with S11's stop: the radio switches off
#

trace=/usr/sbin/x6100-starttrace
[ -x "$trace" ] || trace=:
"$trace" "power off: stopping the init scripts"

x6200=false
grep -q "xiegu,x6200" /proc/device-tree/compatible 2>/dev/null && [ -c /dev/ttyS1 ] && x6200=true

for i in $(ls -r /etc/init.d/S??*) ;do

     # Ignore dangling symlinks (if any).
     [ ! -f "$i" ] && continue

     if $x6200 && [ "${i##*/}" = S11radio_daemon ]; then
          "$trace" "S11radio_daemon stop: its s to the base comes last"
          continue
     fi
     "$trace" "${i##*/} stop"
     case "$i" in
	*.sh)
	    # Source shell script for speed.
	    (
		trap - INT QUIT TSTP
		set stop
		. $i
	    )
	    ;;
	*)
	    # No sh extension, so fork subprocess.
	    $i stop
	    ;;
    esac
done
"$trace" "init scripts stopped"

if $x6200; then
    # The last line the trace can have: once DATA is unmounted it has nowhere to go. One more after it says DATA
    # was busy, and by what
    "$trace" "the base's power off: DATA unmounted, the system read-only, then s to the base"
    sync
    if ! umount /mnt 2>/dev/null; then
        "$trace" "DATA busy (pids $(fuser -m /mnt 2>/dev/null)): read-only instead"
        sync
        mount -o remount,ro /mnt 2>/dev/null
    fi
    mount -o remount,ro / 2>/dev/null
    sync
    stty -F /dev/ttyS1 1152000 && echo s > /dev/ttyS1
    # The base cuts the power about 3 s after it. Still here after this, the shutdown goes on as before
    sleep 6
fi
