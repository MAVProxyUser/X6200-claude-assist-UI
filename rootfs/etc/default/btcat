# Bluetooth CAT (SPP) defaults. Runtime state (set from the GUI menu)
# is stored in /mnt/btcat.conf and overrides these values.
BTCAT_ENABLE=yes
# Bluetooth adapter power
BTCAT_BT=yes
# The name a PC sees (BTCAT_ALIAS): the radio's model by default (btcat-setup); set one in /mnt/btcat.conf to change it
