#!/usr/bin/env python3
# OpenX6X00 updater: the GUI, the web server, the helpers and the data they install, replaced on
# the running radio from a bundle (tools/update/mkbundle.py), with a journal and the previous
# files kept so a bad version goes back by itself. Every command prints one line or one JSON object
# on stdout, exit 0/1.
#
#   status                   {"running":..,"pending":..,"last":..,"image":{..}}
#   check                    {"running":..,"latest":..,"url":..,"newer":bool,"commit":..,"image_needed":bool,..}
#                            (GitHub Releases; commit: the newer release's tag's commit, for the GUI's question)
#
# The card image: what an update cannot carry (the root filesystem's packages, the partitions) comes with a card
# image. Each version says which image level it wants per radio (/usr/share/x6100/image-required); the image build
# stamps its level into /etc/openx6x00-image. A level that only the kernel or U-Boot brings has a "<model>-boot <level>
# <parts>" line there too: the bundle's own kernel and U-Boot reach it (install --kernel/--uboot), recorded in
# /var/lib/x6100-update/boot-level, and no card image is needed for it. "check" reads the newer release's file and
# says whether it also wants a newer card image (or which of the bundle's parts instead); "status" says whether the
# running software does.
#   download <url>           the bundle into /mnt/update, progress in /mnt/update/.progress
#   install <file> [--kernel] [--uboot] [--reboot]
#                            verify, stage, swap in, restart the GUI and the web server; with --kernel the bundle's
#                            kernel set (zImage, the DTB, boot.scr) onto the SD card's boot partition and its modules
#                            into /lib/modules, with --uboot its U-Boot into the card's raw area: only on the SD
#                            card the radio started from (never the internal eMMC), each only when asked (the GUI's
#                            checkboxes), both from the next power-on (nothing here reboots). A part the bundle does
#                            not carry, or that the card has already, is left (and said). The modules of a kernel
#                            neither running, on the card, nor the one it replaced go from /lib/modules, and so do
#                            the files of the kernel's own release that its new set no longer ships (kept till the
#                            next kernel install, for boot-rollback)
#   bundle-info <file>       {"version":..,"sd":..,"kernel":..,"uboot":..,"need_kernel":..,"need_uboot":..,
#                            "image_needed":..}: whether the bundle's kernel set and U-Boot differ from the SD card's
#                            (what the GUI offers to tick), and whether its version needs them (its card image level)
#   boot-rollback            the kernel set, modules and U-Boot the last --kernel/--uboot replaced, back on the card
#   upgrade [--kernel] [--uboot] [--reboot]
#                            check, download and install the newer release (the flags as install's)
#   rollback                 the previous files back, restart
#   confirm                  the new version runs: the pending mark goes (the GUI, after a minute)
#   boot-check               before each GUI start (x6100_daemon): a pending version that keeps
#                            dying is rolled back
#   fault settings           the pending version could not use the settings file (the GUI, at its start):
#                            the step back that follows says so instead of "did not stay up"
#   notice                   "ok <text>" once after a version was taken back, what the GUI shows at its
#                            next start; "ok" when there is nothing (new) to say
#
# A step back is kept in last.json with its reason ("reason": starts, settings, hand, interrupted) and the
# sentence that says it ("text"); status gives that sentence for a last.json of an earlier updater too, from
# the fields it has. "why" stays for the web pages of the versions before, which show it.
#
# Going back by hand to a version before Tailscale Funnel (rollback, or the install of its bundle) takes Funnel
# off first, and refuses when it cannot be sure of that (#58): that version would leave the funnel on the
# internet. boot-check's own step back tries the same, and goes back whatever came of it.
#
# SPDX-License-Identifier: LGPL-2.1-or-later
# Copyright (c) 2026 Joeri Van Dooren ON6URE / Guru-RF
import hashlib
import fcntl
import json
import os
import shutil
import signal
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.request

REPO_FILE = "/usr/share/x6100/update-repo"          # owner/name, written by the build (CMakeLists.txt UPDATE_REPO)
DEFAULT_REPO = "MAVProxyUser/X6200-claude-assist-UI"


def update_repo():
    """The GitHub repository whose releases this radio updates from: X6100_UPDATE_REPO, else the one the image was
    built from (GitHub Actions' own repository, so a fork's images update from that fork; a local build's origin),
    else this fork's"""
    for r in (os.environ.get("X6100_UPDATE_REPO", ""), _read(REPO_FILE)):
        r = r.strip()
        if r.count("/") == 1 and all(p and all(c.isalnum() or c in "-_." for c in p) for p in r.split("/")):
            return r
    return DEFAULT_REPO


def _read(path):
    try:
        with open(path) as f:
            return f.read(200)
    except OSError:
        return ""


REPO = update_repo()
API = f"https://api.github.com/repos/{REPO}/releases/latest"
# Bundles carry no signature and none is asked for: there is no key to keep, and a fork updates from its own
# releases as they are. A download rests on HTTPS to GitHub and the repository's owner, each file on the manifest
VERSION_FILE = "/usr/share/x6100/app-version"
IMAGE_STAMP = "/etc/openx6x00-image"                 # written by the image build only, never by an update
IMAGE_REQUIRED = "/usr/share/x6100/image-required"   # comes with each version
RAW = f"https://raw.githubusercontent.com/{REPO}/v{{tag}}/rootfs/usr/share/x6100/image-required"
STATE = "/var/lib/x6100-update"       # the journal and the previous files: on the root filesystem
PREV = os.path.join(STATE, "prev")
JOURNAL = os.path.join(STATE, "journal.json")
PENDING = os.path.join(STATE, "pending.json")
LAST = os.path.join(STATE, "last.json")
WORK = "/mnt/update"                  # the download and the staging: the DATA partition has the room
PROGRESS = os.path.join(WORK, ".progress")
# The bundle's manifest names its product: GoldCorpHF. The line in the sand is v0.3.12.20: the firmware's first under
# that name, its bundle still marked OpenX6X00 (the name it had before), so the updaters of v0.3.12.19 and before
# take it and bring this one. After it, GoldCorpHF only: no other OpenX6X00 bundle (upstream's) is taken here
PRODUCT = "GoldCorpHF"
BRIDGE = ("OpenX6X00", "0.3.12.20")


def product_ok(m):
    return m.get("product") == PRODUCT or (m.get("product"), str(m.get("version"))) == BRIDGE
ALLOWED = ("/usr/sbin/", "/usr/bin/", "/usr/lib/", "/usr/share/x6100/",
           "/etc/init.d/", "/etc/")
# The SD card the radio started from (OpenX6X00 runs from it; the internal eMMC, Xiegu's own system, mmcblk2, is
# never written): its kernel set on the FAT boot partition (genimage: zImage, sun8i-r16-<model>.dtb, boot.scr), U-Boot
# raw from byte 8 KiB in the 1016 KiB before that partition (sunxi), the kernel's modules in /lib/modules on its root
SD_NAME = "mmcblk0"
SD_DEV = "/dev/mmcblk0"
SD_BOOT = "/dev/mmcblk0p1"
SYS_BLOCK = "/sys/block"
CMDLINE = "/proc/cmdline"
BOOT_MNT = "/tmp/x6100-update-boot"
UBOOT_OFFSET = 8 * 1024
UBOOT_AREA = 1016 * 1024
MODULES_ROOT = "/"                    # where the modules' /lib/modules/... paths go (the tests point it elsewhere)
BOOT_JOURNAL = os.path.join(STATE, "boot-journal.json")   # the last --kernel/--uboot, for its undo
BOOT_PREV = os.path.join(STATE, "boot-prev")              # the module files it replaced
UBOOT_PREV = os.path.join(STATE, "uboot-prev.bin")        # the U-Boot area it replaced, whole
BOOT_LEVEL = os.path.join(STATE, "boot-level")            # the card image level the card's kernel/U-Boot reached
# The SD card's kernel or U-Boot written (install --kernel/--uboot, boot-rollback) in the boot named here: they start at
# the next power-on, and the GUI asks for one at each of its starts in this same boot (update_watch.c), then removes it
POWERON = os.path.join(STATE, "poweron.json")
BOOT_ID = "/proc/sys/kernel/random/boot_id"
IMAGE_MEMBER = "files" + IMAGE_REQUIRED                   # a bundle's own image-required file
BOOT_PARTS = ("kernel", "uboot")
MAX_STARTS = 3                        # GUI starts without a confirm before the rollback
TIMEOUT = 30
RUN_LIMIT = 1800
LOCK = os.path.join(STATE, "lock")    # one updater at a time: the browser, the GUI and the start loop share it
LOCK_WAIT = int(os.environ.get("X6100_UPDATE_LOCK_WAIT", "120"))
TAILSCALE = "/usr/sbin/x6100-tailscale"
TAILSCALE_STATE = "/var/lib/tailscale/tailscaled.state"   # where tailscaled keeps a funnel between its starts
FUNNEL_SINCE = (0, 3, 7)              # the first version that knows Tailscale Funnel (#58) and keeps it off by itself
FUNNEL_WAIT = 30                      # s x6100-tailscale may take to make sure no funnel is left, before a step back
FUNNEL_QUIET_WAIT = 5                 # s the start loop's own step back gives it
FUNNEL_QUIET_LIMIT = 20               # s it waits for x6100-tailscale at most then, whatever that one does


class Fail(Exception):
    pass


def running_version():
    try:
        with open(VERSION_FILE) as f:
            return f.read().strip()
    except OSError:
        return "unknown"


def radio_model():
    """x6100 or x6200, from the device tree: the two radios share this program and the release
    page, each has its own bundle and card image: the X6200's names carry -x6200-, the X6100's
    -x6100-. Without the device tree, the card image's stamp; neither: "unknown", which takes no
    radio's files. An X6200 never takes the X6100's, nor the other way round"""
    try:
        with open("/proc/device-tree/compatible", "rb") as f:
            return "x6200" if b"xiegu,x6200" in f.read() else "x6100"
    except OSError:
        pass
    try:
        with open(IMAGE_STAMP) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == "model" and v in ("x6100", "x6200"):
                    return v
    except OSError:
        pass
    return "unknown"


def image_required(text, model=None):
    """(level, what the image brings) for this radio from an image-required file's text; (1, "") when it
    has no line for it"""
    model = model or radio_model()
    for line in text.splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and not parts[0].startswith("#") and parts[0] == model and parts[1].isdigit():
            return int(parts[1]), parts[2].strip() if len(parts) > 2 else ""
    return 1, ""


def stamp_level():
    """The card image's own level: its stamp, 1 for the images before the stamp (up to v0.3.3)"""
    try:
        with open(IMAGE_STAMP) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == "level" and v.isdigit():
                    return int(v)
    except OSError:
        pass
    return 1


def boot_level():
    """The level an install of a bundle's kernel and U-Boot brought the SD card to (0: none)"""
    t = _read(BOOT_LEVEL).strip()
    return int(t) if t.isdigit() else 0


def set_boot_level(level):
    if level and level > stamp_level():
        save_text(BOOT_LEVEL, f"{level}\n")
    else:
        try:
            os.remove(BOOT_LEVEL)
        except FileNotFoundError:
            pass


def image_level():
    """The running card's level: the image's stamp, or what an install of a bundle's kernel and U-Boot reached"""
    return max(stamp_level(), boot_level())


def image_routes(text, model=None):
    """{level: {"kernel", "uboot"}} from an image-required file's "<model>-boot <level> <parts>" lines: the levels a
    bundle's own kernel and/or U-Boot on the SD card reach from the level below (a kernel fix, the WiFi driver)"""
    model = model or radio_model()
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[0] == f"{model}-boot" and parts[1].isdigit():
            got = {p for p in parts[2:] if p in BOOT_PARTS}
            if got:
                out[int(parts[1])] = got
    return out


def boot_route(text, have, need, model=None):
    """The SD card parts that take a card from level have to need (empty when it is there), None when a level between
    has no route: a card image is needed then"""
    routes = image_routes(text, model)
    parts = set()
    for level in range(have + 1, need + 1):
        if level not in routes:
            return None
        parts |= routes[level]
    return parts


def image_state():
    text = _read_text(IMAGE_REQUIRED)
    need, note = image_required(text) if text else (1, "")
    have = image_level()
    out = {"level": have, "required": need, "needed": have < need, "note": note if have < need else ""}
    route = boot_route(text, have, need) if have < need else None
    if route:
        out["boot"] = sorted(route)       # its kernel/U-Boot reach it: install --kernel/--uboot, no card image
    return out


def bundle_for_this_radio(name):
    return name.endswith("-update.tar.gz") and f"-{radio_model()}-" in name     # this radio's own, never the other's


def vtuple(v):
    out = []
    for part in str(v).lstrip("v").split("."):
        digits = "".join(ch for ch in part if ch.isdigit())
        out.append(int(digits) if digits else 0)
    return tuple(out)


def version_parts(v):
    """A version's numbers, each part's leading digits: 0.3.6-12-g076be5a is 0.3.6 (vtuple makes 0.3.612076 of
    it), and what is no version ("unknown", none) is 0"""
    out = []
    for part in str(v or "").strip().lstrip("v").split("."):
        n = len(part) - len(part.lstrip("0123456789"))
        out.append(int(part[:n]) if n else 0)
        if n < len(part):                 # -12-g076be5a, rc1: what follows is no version number
            break
    return tuple(out)


def before_funnel(version):
    """The version knows nothing of Tailscale Funnel (before 0.3.7), or is not known"""
    v = version_parts(version)
    n = max(len(v), len(FUNNEL_SINCE))
    return v + (0,) * (n - len(v)) < FUNNEL_SINCE + (0,) * (n - len(FUNNEL_SINCE))


def version_name(version, unknown="the version before"):
    return f"v{version}" if version_parts(version) > (0,) else unknown


# Why a version was taken back, as last.json keeps it, and what is said for each
REASONS = ("starts", "settings", "hand", "interrupted")


def rollback_reason(last):
    """The reason of a step back in last.json; for one written before "reason" was kept (v0.3.10 and before), from
    its "why", which each of the three steps back wrote in its own way: none for the one by hand"""
    reason = last.get("reason")
    if reason in REASONS:
        return reason
    why = str(last.get("why") or "")
    if reason is None:
        if not why:
            return "hand"
        if "interrupted" in why:
            return "interrupted"
        if "did not stay up" in why:
            return "starts"
    return ""      # a reason of a later updater, said by its "why"


def rollback_text(last):
    """One line for the screen and the web page: which version was taken back, to which, and why"""
    what = version_name(last.get("version"), "")
    head = f"{'Update ' + what if what else 'The update'} taken back to {version_name(last.get('to'))}"
    reason = rollback_reason(last)
    if reason == "hand":
        return f"{head} by hand"
    if reason == "settings":
        return f"{head}: it could not use the settings file"
    if reason == "interrupted":
        return f"{head}: the install was cut short"
    if reason == "starts":
        n = last.get("starts")
        if not isinstance(n, int):
            digits = "".join(ch if ch.isdigit() else " " for ch in str(last.get("why") or "")).split()
            n = int(digits[0]) if digits else MAX_STARTS
        return f"{head}: it did not stay up a minute in {n} starts"
    why = str(last.get("why") or "").strip()
    return f"{head}: {why}" if why else head


def screen_text(last):
    """The step back for the GUI's message box, two short lines: which version went back to which, then why (the
    web page and status keep the whole sentence of rollback_text). About 30 characters a line show whole there; a
    longer one scrolls past. A reason of a later updater is said in its own words, whole"""
    what = version_name(last.get("version"), "")
    head = f"{what + ' taken back' if what else 'Update taken back'} to {version_name(last.get('to'))}"
    reason = rollback_reason(last)
    if reason == "hand":
        why = "by hand"
    elif reason == "settings":
        why = "it could not use the settings"
    elif reason == "interrupted":
        why = "its install was cut short"
    elif reason == "starts":
        n = last.get("starts")
        if not isinstance(n, int):
            digits = "".join(ch if ch.isdigit() else " " for ch in str(last.get("why") or "")).split()
            n = int(digits[0]) if digits else MAX_STARTS
        why = f"it did not stay up ({n} starts)"
    else:
        why = str(last.get("why") or "").strip() or str(last.get("text") or "").partition(": ")[2].strip()
    return f"{head}\n{why}" if why else head


def last_state():
    """last.json, its sentence with it: the one it keeps, else made from its fields (an earlier updater's file)"""
    last = load(LAST)
    if not isinstance(last, dict):
        return None
    if last.get("result") == "rolled back" and not last.get("text"):
        last["text"] = rollback_text(last)
    return last


def save_rollback(version, to, reason, **more):
    """last.json for a step back: the reason, the sentence, and "why" for the web pages of the versions before"""
    why = {"starts": f"the GUI did not stay up ({more.get('starts', MAX_STARTS)} starts)",
           "settings": "this version could not use the settings file",
           "interrupted": "the install was interrupted", "hand": "taken back by hand"}[reason]
    last = {"result": "rolled back", "version": version, "to": to, "reason": reason, "why": why, **more,
            "when": time.time()}
    last["text"] = rollback_text(last)
    save(LAST, last)


def funnel_off_before(version, what):
    """Going back by hand to a version before Tailscale Funnel (#58): Funnel off first, or not at all. That version never
    looks at the funnel tailscaled keeps in its state (on the root filesystem, which the step back does not touch), and
    its TCI and browser remote would take connections from the internet without a key. x6100-tailscale turns the
    setting off and takes the funnel out of tailscaled, through its local API while it runs, out of its state file while
    it does not, and waits until it is sure. Fail, saying what to do, when it is not; else the note for the result line"""
    if not before_funnel(version):
        return ""
    name = version_name(version)

    def refused(why):
        return Fail(f"{what}: Funnel could not be made sure to be off ({why}). {name} knows nothing of Tailscale Funnel "
                    f"and would leave TCI and the browser remote on the internet without a key: turn Funnel off first, "
                    f"or Tailscale, wait until it says Off, and try again")
    if not os.access(TAILSCALE, os.X_OK):
        if os.path.exists(TAILSCALE_STATE):
            raise refused("x6100-tailscale is missing")
        return ""                         # Tailscale never ran on this card
    try:
        r = subprocess.run([TAILSCALE, "funnel-clear", str(FUNNEL_WAIT)], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=FUNNEL_WAIT + 60)
    except subprocess.TimeoutExpired:
        raise refused("Tailscale did not answer")
    except OSError as e:
        raise refused(e)
    if r.returncode != 0:
        why = (r.stderr.strip().splitlines() or [f"exit code {r.returncode}"])[-1]
        raise refused(why[6:] if why.startswith("error ") else why)
    return f"; Funnel is off now: {name} knows nothing of it" if "taken off" in r.stdout else ""


def funnel_off_quietly(version):
    """The start loop's own step back (boot-check) to a version before Funnel: Funnel off as funnel_off_before does,
    but never in the step back's way. A version that keeps dying goes back whatever came of it, within seconds; with
    Tailscale off or never used x6100-tailscale finds nothing at once, and without it nothing is tried"""
    if not before_funnel(version) or not os.access(TAILSCALE, os.X_OK):
        return
    try:
        subprocess.run([TAILSCALE, "funnel-clear", str(FUNNEL_QUIET_WAIT)], stdin=subprocess.DEVNULL,
                       capture_output=True, timeout=FUNNEL_QUIET_LIMIT)
    except (OSError, subprocess.SubprocessError):
        pass


def load(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    dfd = os.open(os.path.dirname(path), os.O_RDONLY)
    os.fsync(dfd)
    os.close(dfd)


def save_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(path + ".tmp", path)


def progress(step, got=0, total=0):
    os.makedirs(WORK, exist_ok=True)
    with open(PROGRESS + ".tmp", "w") as f:
        f.write(f"{step} {got} {total}\n")
    os.replace(PROGRESS + ".tmp", PROGRESS)


def reboot_radio():
    """The radio restarted instead of the apps (install --reboot): x6x00-reboot, detached, a moment after the answer is
    out (the caller may be the web server). On the X6200 the base stays on, so the radio comes back by itself; the
    SD card's kernel and U-Boot start with it"""
    subprocess.Popen(["setsid", "sh", "-c", "sleep 2; /usr/sbin/x6x00-reboot >/dev/null 2>&1"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def restart_apps():
    """The web server and the GUI, detached: the caller may be the web server itself. The GUI's
    start loop (x6100_daemon) is restarted too, not just the GUI: the loop is a shell script the
    bundle may have changed, and the running shell keeps the old one until it exits. Winlink (Pat and
    ardopcf, which come with the bundle) after them, when it is there; a rollback that took S98winlink away
    stops its supervisor, which stops both programs. sshd reads a changed /etc/ssh/sshd_config when the new web
    server starts (follow_sshd_config): the updaters before it restart the web server too."""
    subprocess.Popen(["setsid", "sh", "-c", "sleep 1; /etc/init.d/S96webserver restart >/dev/null 2>&1; "
                      "/etc/init.d/S95gui restart >/dev/null 2>&1; "
                      "if [ -x /etc/init.d/S98winlink ]; then /etc/init.d/S98winlink restart >/dev/null 2>&1; "
                      "else pid=$(cat /run/winlink/lock 2>/dev/null); [ -n \"$pid\" ] && "
                      "grep -q x6100-winlink /proc/$pid/cmdline 2>/dev/null && kill $pid; fi"],
                     stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


# ---- check and download --------------------------------------------------------------------

def http(url, timeout=TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": f"GoldCorpHF/{running_version()}", "Accept": "application/json"})
    return urllib.request.urlopen(req, timeout=timeout)


def cmd_check(args):
    out = {"running": running_version(), "latest": None, "url": None, "newer": False, "notes": "", "repo": REPO}
    try:
        with http(API) as r:
            rel = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 404:          # no release yet
            return out
        raise Fail(f"GitHub answered HTTP {e.code}")
    except (OSError, ValueError) as e:
        raise Fail(f"no connection to GitHub: {getattr(e, 'reason', e)}")
    tag = str(rel.get("tag_name", "")).lstrip("v")
    asset = next((x for x in rel.get("assets", []) if bundle_for_this_radio(str(x.get("name", "")))), None)
    out["latest"] = tag or None
    out["url"] = asset["browser_download_url"] if asset else None
    out["notes"] = (rel.get("body") or "")[:2000]
    out["newer"] = bool(tag and asset and vtuple(tag) > vtuple(out["running"]))
    out["image_needed"], out["image_note"], out["image_url"] = False, "", None
    out["commit"] = ""
    if out["newer"]:
        # The commit the release was built from, which the GUI shows before it asks to apply it: the tag's, as a
        # bare SHA (the commit's JSON would carry its whole diff); none is no harm
        try:
            req = urllib.request.Request(f"https://api.github.com/repos/{REPO}/commits/v{tag}",
                                         headers={"User-Agent": f"GoldCorpHF/{running_version()}",
                                                  "Accept": "application/vnd.github.sha"})
            with urllib.request.urlopen(req, timeout=10) as r:
                sha = r.read(64).decode(errors="replace").strip()
            if len(sha) == 40 and all(c in "0123456789abcdef" for c in sha):
                out["commit"] = sha
        except Exception:
            pass
        # Does the newer release also want a newer card image for this radio? Its own image-required file, at
        # its tag; no answer is no warning
        # A level its bundle's own kernel and U-Boot reach is no card image: "image_boot" names the parts instead
        try:
            with http(RAW.format(tag=tag), timeout=10) as r:
                text = r.read(4096).decode(errors="replace")
            need, note = image_required(text)
            have = image_level()
            route = boot_route(text, have, need) if need > have else None
            if route:
                out["image_boot"], out["image_note"] = sorted(route), note
            elif need > have:
                img = next((x for x in rel.get("assets", []) if str(x.get("name", "")).endswith("-sdcard.img.zip")
                            and f"-{radio_model()}-" in str(x.get("name"))), None)
                out["image_needed"], out["image_note"] = True, note
                out["image_url"] = img["browser_download_url"] if img else rel.get("html_url")
        except Exception:      # http.client errors are neither OSError nor ValueError: never fatal here
            pass
    return out


def cmd_download(args):
    url = args[0]
    os.makedirs(WORK, exist_ok=True)
    dest = os.path.join(WORK, "bundle.tar.gz")
    got = 0
    with http(url, timeout=60) as r, open(dest + ".part", "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        progress("download", 0, total)
        while True:
            chunk = r.read(65536)
            if not chunk:
                break
            f.write(chunk)
            got += len(chunk)
            progress("download", got, total)
        f.flush()
        os.fsync(f.fileno())
    if total and got != total:
        raise Fail(f"short download: {got} of {total} bytes")
    os.replace(dest + ".part", dest)
    return dest


# ---- verify and install --------------------------------------------------------------------

def read_manifest(tar):
    try:
        mjson = tar.extractfile("manifest.json").read()
    except (KeyError, AttributeError):
        raise Fail("not an update bundle: no manifest")
    return check_manifest(mjson)


def bundle_manifest(bundle, image=False):
    """A bundle's manifest, checked, without unpacking the rest: it is the tar's first member, read as the system's
    gzip streams it. With image, (manifest, its image-required file's text): read on from the stream till that file
    ("" when the bundle has none)"""
    p = subprocess.Popen(["gzip", "-dc", bundle], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    m = None
    try:
        with tarfile.open(fileobj=p.stdout, mode="r|") as tar:
            for ti in tar:
                if ti.name == "manifest.json":
                    m = check_manifest(tar.extractfile(ti).read())
                    if not image:
                        return m
                elif m is not None and ti.name == IMAGE_MEMBER:
                    return m, tar.extractfile(ti).read(4096).decode(errors="replace")
                elif m is not None and ti.name.startswith("boot/"):
                    break                       # the files are before the SD card's parts
        if m is None:
            raise Fail("not an update bundle: no manifest")
        return m, ""
    except tarfile.TarError:
        raise Fail("not an update bundle")
    finally:
        p.kill()
        p.stdout.close()
        p.wait()


def boot_section(m):
    """The manifest's "boot" part, checked ({} when the bundle carries none): the kernel set's names are plain file
    names for the boot partition, its modules' paths are under /lib/modules/, U-Boot fits its area at its offset"""
    b = m.get("boot") or {}
    if not isinstance(b, dict):
        raise Fail("the manifest's boot part is not readable")
    k = b.get("kernel")
    if k:
        if not isinstance(k.get("files"), list) or not k["files"]:
            raise Fail("the bundle's kernel has no files")
        for e in k["files"]:
            n = str(e.get("name", ""))
            if not n or "/" in n or n.startswith(".") or n.endswith((".prev", ".x6new")):
                raise Fail(f"the bundle wants {n!r} on the boot partition: refused")
        for e in k.get("modules", []):
            p = str(e.get("path", ""))
            if not p.startswith("/lib/modules/") or ".." in p.split("/") or p.endswith("/"):
                raise Fail(f"the bundle wants to write {p}: refused")
    u = b.get("uboot")
    if u:
        try:
            ok = 0 < int(u.get("size", 0)) <= UBOOT_AREA and int(u.get("offset", -1)) == UBOOT_OFFSET
        except (TypeError, ValueError):
            ok = False
        if not ok or "/" in str(u.get("name", "/")):
            raise Fail("the bundle's U-Boot does not fit its area: refused")
    return b


def check_manifest(mjson):
    # No signature: a manifest.sig in an older bundle is left unread. Each file is checked against the manifest's
    # SHA-256 below; where the bundle came from is the repository's releases over HTTPS, or the owner's own file
    try:
        m = json.loads(mjson)
    except ValueError:
        raise Fail("the manifest is not JSON")
    if not isinstance(m, dict) or not product_ok(m) or not isinstance(m.get("files"), list) \
            or not m.get("version"):
        raise Fail("the manifest is not for this firmware")
    if m.get("model", "x6100") != radio_model():
        raise Fail(f"the bundle is for the {m.get('model', 'x6100').upper()}, this radio is a {radio_model().upper()}")
    for e in m["files"]:
        p = e.get("path", "")
        if not p.startswith("/") or ".." in p.split("/") or not p.startswith(ALLOWED) or p.endswith("/"):
            raise Fail(f"the bundle wants to write {p}: refused")
    boot_section(m)
    return m


def _stage_one(tar, member, dest, sha, mode=None):
    """One member of the bundle into dest, checked against its SHA-256"""
    try:
        src = tar.extractfile(member)
    except KeyError:
        src = None
    if src is None:
        raise Fail(f"{member.split('/', 1)[-1]} is missing from the bundle")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    h = hashlib.sha256()
    with open(dest, "wb") as f:
        while True:
            chunk = src.read(65536)
            if not chunk:
                break
            h.update(chunk)
            f.write(chunk)
        f.flush()
        os.fsync(f.fileno())
    if h.hexdigest() != sha:
        raise Fail(f"{member.split('/', 1)[-1]} does not match its checksum")
    if mode is not None:
        os.chmod(dest, mode)


def stage(bundle, kernel=False, uboot=False):
    """The bundle's files into WORK/stage, each checked against the manifest; with kernel and uboot the SD card's
    parts too, into WORK/stage-boot (the kernel set, its modules under modules/, U-Boot). Returns the manifest."""
    st = os.path.join(WORK, "stage")
    bst = os.path.join(WORK, "stage-boot")
    shutil.rmtree(st, ignore_errors=True)
    shutil.rmtree(bst, ignore_errors=True)
    os.makedirs(st)
    # Decompressed by the system's gzip: the radio's Python may come without zlib
    plain = os.path.join(WORK, "bundle.tar")
    # A bundle refused (another radio's, a checksum, not a bundle at all) leaves nothing behind on DATA: the
    # unpacked tar goes whatever happens, the staged files with it when the bundle is refused
    try:
        with open(plain, "wb") as f:
            r = subprocess.run(["gzip", "-dc", bundle], stdout=f, stderr=subprocess.PIPE)
        if r.returncode != 0:
            raise Fail("not a gzip file")
        with tarfile.open(plain, "r:") as tar:
            m = read_manifest(tar)
            b = boot_section(m)
            if kernel and not b.get("kernel"):
                raise Fail("the bundle carries no kernel")
            if uboot and not b.get("uboot"):
                raise Fail("the bundle carries no U-Boot")
            boot = ([("boot/" + e["name"], os.path.join(bst, e["name"]), e["sha256"], None)
                     for e in b["kernel"]["files"]] +
                    [("files" + e["path"], os.path.join(bst, "modules", e["path"].lstrip("/")), e["sha256"],
                      int(str(e.get("mode", "644")), 8)) for e in b["kernel"].get("modules", [])]) if kernel else []
            if uboot:
                boot.append(("boot/" + b["uboot"]["name"], os.path.join(bst, b["uboot"]["name"]), b["uboot"]["sha256"],
                             None))
            n = len(m["files"]) + len(boot)
            for i, e in enumerate(m["files"]):
                progress("verify", i, n)
                dest = os.path.join(st, e["path"].lstrip("/"))
                _stage_one(tar, "files" + e["path"], dest, e.get("sha256"), int(str(e.get("mode", "644")), 8))
            for i, (member, dest, sha, mode) in enumerate(boot):
                progress("verify", len(m["files"]) + i, n)
                _stage_one(tar, member, dest, sha, mode)
    except BaseException:
        shutil.rmtree(st, ignore_errors=True)
        shutil.rmtree(bst, ignore_errors=True)
        raise
    finally:
        try:
            os.remove(plain)
        except FileNotFoundError:
            pass
    return m


# ---- the SD card's kernel and U-Boot (install --kernel/--uboot), each only when asked --------------------------

def _read_text(path, n=4096):
    try:
        with open(path) as f:
            return f.read(n)
    except OSError:
        return ""


def sd_card_check():
    """The kernel and U-Boot go only to the SD card the radio started from: mmcblk0 says it is an SD card (the
    internal eMMC says MMC and is never written), the kernel was started with its root on that card's second
    partition, and the card's boot partition starts at 1 MiB or after (U-Boot's area ends there). Anything else is
    refused before a byte is written"""
    kind = _read_text(os.path.join(SYS_BLOCK, SD_NAME, "device", "type")).strip()
    if kind != "SD":
        raise Fail(f"{SD_NAME} is not an SD card ({kind or 'no type'}): the kernel and U-Boot go only to the card "
                   "the radio started from")
    if f"root=/dev/{SD_NAME}p2" not in _read_text(CMDLINE).split():
        raise Fail("the radio did not start from the SD card: no kernel or U-Boot written")
    start = _read_text(os.path.join(SYS_BLOCK, SD_NAME, SD_NAME + "p1", "start")).strip()
    if not start.isdigit() or int(start) * 512 < UBOOT_OFFSET + UBOOT_AREA:
        raise Fail("the SD card's boot partition starts inside U-Boot's area: nothing written")


def boot_mount(ro=False):
    """The SD card's FAT boot partition, mounted in /tmp for the kernel set: its path"""
    os.makedirs(BOOT_MNT, exist_ok=True)
    if not os.path.ismount(BOOT_MNT):
        r = subprocess.run(["mount", "-t", "vfat"] + (["-o", "ro"] if ro else []) + [SD_BOOT, BOOT_MNT],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode != 0:
            raise Fail("the SD card's boot partition did not mount: " + r.stderr.decode(errors="replace").strip()[:80])
    return BOOT_MNT


def boot_umount():
    subprocess.run(["umount", BOOT_MNT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.sync()


def _sha_file(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
    except OSError:
        return ""
    return h.hexdigest()


def _fsync_path(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def uboot_read(n=UBOOT_AREA):
    """The SD card's U-Boot area as it is on the card"""
    with open(SD_DEV, "rb") as d:
        d.seek(UBOOT_OFFSET)
        return d.read(n)


def uboot_write(area):
    """area onto the card at U-Boot's offset, synced, the block device's cache dropped so the next read reads the card"""
    fd = os.open(SD_DEV, os.O_WRONLY)
    try:
        os.lseek(fd, UBOOT_OFFSET, os.SEEK_SET)
        view = memoryview(area)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
        try:
            fcntl.ioctl(fd, 0x1261)         # BLKFLSBUF
        except OSError:
            pass
    finally:
        os.close(fd)


def boot_kernel(m, j):
    """The kernel's modules into /lib/modules (each file replaced kept in boot-prev), then its set onto the SD card's
    boot partition (each old file kept beside it as <name>.prev, the room checked first; the new one written as
    <name>.x6new, synced, renamed over): every step journalled for boot_undo. The modules first: the kernel on the card
    is the old one till its own files are swapped, and its modules are in its own release's folder. Then the files of
    that folder the new set does not ship (an older build of the same release had them, its modules.dep lists none of
    them now) move into boot-prev too"""
    b = m["boot"]["kernel"]
    bst = os.path.join(WORK, "stage-boot")
    files, mods = b["files"], b.get("modules", [])
    n = len(files) + len(mods)
    jk = j["kernel"] = {"files": [], "modules": [], "release": str(b.get("release", ""))}
    shutil.rmtree(BOOT_PREV, ignore_errors=True)
    for i, e in enumerate(mods):
        progress("kernel", i, n)
        rel = e["path"].lstrip("/")
        p = os.path.join(MODULES_ROOT, rel)
        rec = {"path": e["path"], "prev": os.path.exists(p), "done": False}
        jk["modules"].append(rec)
        if rec["prev"]:
            keep = os.path.join(BOOT_PREV, rel)
            os.makedirs(os.path.dirname(keep), exist_ok=True)
            shutil.copy2(p, keep)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        tmp = p + ".x6new"
        shutil.copyfile(os.path.join(bst, "modules", rel), tmp)
        os.chmod(tmp, int(str(e.get("mode", "644")), 8))
        _fsync_path(tmp)
        rec["replacing"] = True
        save(BOOT_JOURNAL, j)
        os.replace(tmp, p)
        rec["done"] = True
        save(BOOT_JOURNAL, j)
    boot_stale(j, mods)
    d = boot_mount()
    try:
        need = sum(int(e.get("size", 0)) for e in files) + \
            sum(os.path.getsize(os.path.join(d, e["name"])) for e in files if os.path.exists(os.path.join(d, e["name"])))
        if shutil.disk_usage(d).free < need + 1024 * 1024:
            raise Fail("no room on the SD card's boot partition for the new kernel beside the one kept")
        for i, e in enumerate(files):
            progress("kernel", len(mods) + i, n)
            p = os.path.join(d, e["name"])
            rec = {"name": e["name"], "prev": os.path.exists(p), "done": False}
            jk["files"].append(rec)
            if rec["prev"]:
                shutil.copyfile(p, p + ".prev")
                _fsync_path(p + ".prev")
            tmp = p + ".x6new"
            shutil.copyfile(os.path.join(bst, e["name"]), tmp)
            _fsync_path(tmp)
            rec["replacing"] = True
            save(BOOT_JOURNAL, j)
            os.replace(tmp, p)
            rec["done"] = True
            save(BOOT_JOURNAL, j)
    finally:
        boot_umount()


def boot_stale(j, mods):
    """The files in the new modules' release folder that the new set does not ship, moved into boot-prev (the list
    journalled first, so boot_undo finds each where it is), and the folders that leaves empty removed. Symlinks are
    left (build/, source/)"""
    jk = j["kernel"]
    release = jk.get("release", "")
    if not mods or not release or "/" in release:
        return
    top = os.path.join(MODULES_ROOT, "lib", "modules", release)
    ship = {os.path.normpath(os.path.join(MODULES_ROOT, e["path"].lstrip("/"))) for e in mods}
    stale = []
    for root, dirs, fs in os.walk(top):
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
        for n in fs:
            p = os.path.join(root, n)
            if not os.path.islink(p) and os.path.isfile(p) and os.path.normpath(p) not in ship:
                stale.append("/" + os.path.relpath(p, MODULES_ROOT))
    if not stale:
        return
    jk["stale"], jk["stale_state"] = sorted(stale), "moving"
    save(BOOT_JOURNAL, j)
    for path in jk["stale"]:
        rel = path.lstrip("/")
        keep = os.path.join(BOOT_PREV, rel)
        os.makedirs(os.path.dirname(keep), exist_ok=True)
        shutil.move(os.path.join(MODULES_ROOT, rel), keep)
    for root, dirs, fs in os.walk(top, topdown=False):
        if root != top and not os.listdir(root):
            os.rmdir(root)
    os.sync()
    jk["stale_state"] = "moved"
    save(BOOT_JOURNAL, j)


def boot_uboot(m, j):
    """U-Boot into the SD card's raw area (the image, then zeros to the area's end, as the card image has it): the
    area before it saved whole first, the new one written, read back from the card and compared; the old one put back
    when it does not read back as written"""
    u = m["boot"]["uboot"]
    with open(os.path.join(WORK, "stage-boot", u["name"]), "rb") as f:
        data = f.read()
    new = data + bytes(UBOOT_AREA - len(data))
    progress("uboot", 0, 2)
    old = uboot_read()
    if len(old) != UBOOT_AREA:
        raise Fail("the SD card's U-Boot area could not be read whole: nothing written")
    if old == new:
        j["uboot"] = {"state": "same"}
        save(BOOT_JOURNAL, j)
        return
    os.makedirs(os.path.dirname(UBOOT_PREV), exist_ok=True)
    with open(UBOOT_PREV + ".tmp", "wb") as f:
        f.write(old)
        f.flush()
        os.fsync(f.fileno())
    os.replace(UBOOT_PREV + ".tmp", UBOOT_PREV)
    j["uboot"] = {"state": "writing", "prev_sha": hashlib.sha256(old).hexdigest(),
                  "new_sha": hashlib.sha256(new).hexdigest()}
    save(BOOT_JOURNAL, j)
    uboot_write(new)
    progress("uboot", 1, 2)
    if uboot_read() != new:
        uboot_write(old)
        j["uboot"]["state"] = "restored"
        save(BOOT_JOURNAL, j)
        raise Fail("U-Boot did not read back from the SD card as written: the one before is back")
    j["uboot"]["state"] = "written"
    save(BOOT_JOURNAL, j)


def boot_undo(j):
    """What a --kernel/--uboot changed, back: U-Boot's saved area (checked against the sum journalled), the kernel
    set's .prev files (a file that was new goes), the files the new set did not ship and the modules from boot-prev (a
    module that was new goes, and its release's folder when nothing is left in it). Safe to run again after an
    interruption: each step is journalled"""
    u = j.get("uboot") or {}
    if u.get("state") in ("writing", "written"):
        try:
            with open(UBOOT_PREV, "rb") as f:
                old = f.read()
        except OSError:
            old = b""
        if len(old) == UBOOT_AREA and hashlib.sha256(old).hexdigest() == u.get("prev_sha"):
            if uboot_read() != old:
                uboot_write(old)
            u["state"] = "restored"
            save(BOOT_JOURNAL, j)
    k = j.get("kernel") or {}
    files = [f for f in k.get("files", []) if (f.get("done") or f.get("replacing")) and not f.get("restored")]
    if files:
        d = boot_mount()
        try:
            for f in reversed(files):
                p = os.path.join(d, f["name"])
                if f.get("prev"):
                    if os.path.exists(p + ".prev"):
                        os.replace(p + ".prev", p)
                else:
                    try:
                        os.remove(p)
                    except FileNotFoundError:
                        pass
                f["restored"] = True
                save(BOOT_JOURNAL, j)
        finally:
            boot_umount()
    if k.get("stale_state") in ("moving", "moved"):
        for path in k.get("stale", []):
            rel = path.lstrip("/")
            p, keep = os.path.join(MODULES_ROOT, rel), os.path.join(BOOT_PREV, rel)
            if os.path.exists(keep) and not os.path.exists(p):
                os.makedirs(os.path.dirname(p), exist_ok=True)
                shutil.move(keep, p)
        k["stale_state"] = "restored"
        save(BOOT_JOURNAL, j)
    for f in reversed(k.get("modules", [])):
        if f.get("restored") or not (f.get("done") or f.get("replacing")):
            continue
        rel = f["path"].lstrip("/")
        p = os.path.join(MODULES_ROOT, rel)
        keep = os.path.join(BOOT_PREV, rel)
        if f.get("prev"):
            if os.path.exists(keep):
                os.replace(keep, p)
        else:
            try:
                os.remove(p)
            except FileNotFoundError:
                pass
        f["restored"] = True
        save(BOOT_JOURNAL, j)
    release = k.get("release")
    if release and "/" not in release:
        top = os.path.join(MODULES_ROOT, "lib", "modules", release)
        if os.path.isdir(top) and not any(fs for _, _, fs in os.walk(top)):
            shutil.rmtree(top, ignore_errors=True)
    os.sync()


def boot_same(b):
    """Which of a bundle's SD card parts the card has already, byte for byte: {"kernel": .., "uboot": ..} (a part the
    bundle does not carry: False). The card must have passed sd_card_check"""
    out = {"kernel": False, "uboot": False}
    if b.get("kernel"):
        d = boot_mount(ro=True)
        try:
            out["kernel"] = all(_sha_file(os.path.join(d, e["name"])) == e["sha256"] for e in b["kernel"]["files"])
        finally:
            boot_umount()
    if b.get("uboot"):
        u = b["uboot"]
        out["uboot"] = hashlib.sha256(uboot_read(int(u["size"]))).hexdigest() == u["sha256"]
    return out


def running_release():
    return os.uname().release


def card_release(prev):
    """The kernel release on the SD card as the last install of one knows it (what it put there, or what it found
    when it was taken back), else the one running"""
    if isinstance(prev, dict):
        if prev.get("state") == "done" and prev.get("card_after"):
            return prev["card_after"]
        if prev.get("state") == "rolled back" and prev.get("card_before"):
            return prev["card_before"]
    return running_release()


def prune_modules(keep):
    """The folders in /lib/modules of kernels nothing can start any more go (about 15 MB each): kept are the one
    running, the one on the card and the one it replaced (boot-rollback's). Only a kernel's folder (modules.dep or
    kernel/ in it) is taken; never anything when the running kernel's own is not in keep"""
    keep = {k for k in keep if k}
    top = os.path.join(MODULES_ROOT, "lib", "modules")
    if running_release() not in keep or not os.path.isdir(top):
        return []
    gone = []
    for d in sorted(os.listdir(top)):
        p = os.path.join(top, d)
        if d in keep or os.path.islink(p) or not os.path.isdir(p):
            continue
        if not (os.path.exists(os.path.join(p, "modules.dep")) or os.path.isdir(os.path.join(p, "kernel"))):
            continue
        shutil.rmtree(p, ignore_errors=True)
        gone.append(d)
    return gone


def apply(m):
    """The staged files into place, one by one, the previous ones kept and the journal ahead of each step."""
    st = os.path.join(WORK, "stage")
    shutil.rmtree(PREV, ignore_errors=True)
    modes = {e["path"]: int(str(e.get("mode", "644")), 8) for e in m["files"]}
    files = [{"path": e["path"], "prev": os.path.exists(e["path"]), "done": False} for e in m["files"]]
    journal = {"version": m["version"], "from": running_version(), "state": "applying", "files": files,
               "started": time.time()}
    save(JOURNAL, journal)
    n = len(files)
    for i, f in enumerate(files):
        progress("install", i, n)
        p = f["path"]
        if f["prev"]:
            keep = os.path.join(PREV, p.lstrip("/"))
            os.makedirs(os.path.dirname(keep), exist_ok=True)
            shutil.copy2(p, keep)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        tmp = p + ".x6new"
        shutil.copy2(os.path.join(st, p.lstrip("/")), tmp)
        # The manifest's mode, not the staged copy's: WORK is on DATA, a FAT partition that keeps none (each file
        # shows the mount's mask: 0755 from a start, 0700 mounted from an SSH shell), and copy2 carried that over,
        # every file of the system 0755, libraries and data alike, or 0700 and closed to the daemons not run as root;
        # NetworkManager refused SmartCW's profile (0600) as 0755
        os.chmod(tmp, modes[p])
        fd = os.open(tmp, os.O_RDONLY)
        os.fsync(fd)
        os.close(fd)
        # The intent first: power lost between the replace and the journal would otherwise leave
        # a new file the rollback believed untouched (audit A02)
        f["replacing"] = True
        save(JOURNAL, journal)
        os.replace(tmp, p)
        f["done"] = True
        save(JOURNAL, journal)
    # The version file follows the manifest, whatever the bundle's copy says (a bundle built
    # without a configure carried a stale one); the rollback restores the previous one from PREV
    if running_version() != m["version"]:
        tmp = VERSION_FILE + ".x6new"
        with open(tmp, "w") as f:
            f.write(m["version"] + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)        # whatever the umask of the one running this
        os.replace(tmp, VERSION_FILE)
    # The crash counter before the state: an interruption between the two still rolls back
    save(PENDING, {"version": m["version"], "from": journal["from"], "starts": 0, "since": time.time()})
    journal["state"] = "applied"
    save(JOURNAL, journal)
    shutil.rmtree(st, ignore_errors=True)
    os.sync()


def undo(journal):
    """Every file the journal says was, or may have been, replaced goes back (or away, when it was
    new). Safe to run again after an interruption: each restoration is journalled, and a file whose
    saved copy is gone was restored already and is left as it is (audit A03)."""
    for f in reversed(journal.get("files", [])):
        if f.get("restored") or not (f.get("done") or f.get("replacing")):
            continue
        p = f["path"]
        keep = os.path.join(PREV, p.lstrip("/"))
        if f.get("prev"):
            if os.path.exists(keep):
                os.replace(keep, p)
        else:
            try:
                os.remove(p)
            except FileNotFoundError:
                pass
        f["restored"] = True
        save(JOURNAL, journal)
    os.sync()


def cmd_install(args):
    flags = [a for a in args if a.startswith("--")]
    rest = [a for a in args if not a.startswith("--")]
    if any(f not in ("--kernel", "--uboot", "--reboot") for f in flags):
        raise Fail("install takes --kernel, --uboot and --reboot")
    if not rest:
        raise Fail("install needs the bundle's path")
    kernel, uboot, reboot = "--kernel" in flags, "--uboot" in flags, "--reboot" in flags
    bundle = rest[0]
    if load(JOURNAL, {}).get("state") == "applying":
        raise Fail("an interrupted install must be rolled back first")
    if (kernel or uboot) and load(BOOT_JOURNAL, {}).get("state") == "applying":
        raise Fail("an interrupted kernel or U-Boot install must be undone first (boot-check)")
    left = []
    if kernel or uboot:
        sd_card_check()                 # before anything: only the SD card the radio started from
        # A part the bundle does not carry, or that the card has already, is left as it is, and said
        b = boot_section(bundle_manifest(bundle))
        same = boot_same(b)
        for part, what in (("kernel", "the kernel"), ("uboot", "U-Boot")):
            if not (kernel if part == "kernel" else uboot):
                continue
            if not b.get(part):
                left.append(f"the bundle carries no {'kernel' if part == 'kernel' else 'U-Boot'}")
            elif same[part]:
                left.append(f"{what} on the SD card is the bundle's already")
            else:
                continue
            if part == "kernel":
                kernel = False
            else:
                uboot = False
    progress("verify")
    m = stage(bundle, kernel, uboot)
    try:
        note = funnel_off_before(m["version"], "not installed")     # an older version's bundle (#58)
    except Fail:
        shutil.rmtree(os.path.join(WORK, "stage"), ignore_errors=True)
        shutil.rmtree(os.path.join(WORK, "stage-boot"), ignore_errors=True)
        raise
    # The SD card's parts first, each undone when a later step fails: a failure leaves nothing changed
    j, said = None, ""
    if kernel or uboot:
        prev = load(BOOT_JOURNAL)
        before = card_release(prev)
        release = str(m["boot"]["kernel"].get("release", "")) if kernel else ""
        j = {"version": m["version"], "from": running_version(), "state": "applying", "started": time.time(),
             "card_before": before, "card_after": (release or None) if kernel else before,
             "level_before": boot_level()}
        save(BOOT_JOURNAL, j)
        try:
            if kernel:
                boot_kernel(m, j)
            if uboot:
                boot_uboot(m, j)
        except BaseException:
            boot_undo(j)
            j["state"] = "rolled back"
            save(BOOT_JOURNAL, j)
            shutil.rmtree(os.path.join(WORK, "stage"), ignore_errors=True)
            raise
        finally:
            shutil.rmtree(os.path.join(WORK, "stage-boot"), ignore_errors=True)
        j["state"] = "done"
        save(BOOT_JOURNAL, j)
        said = " (" + " and ".join((["the kernel"] if kernel else []) + (["U-Boot"] if uboot else [])) + \
            " on the SD card: from the next power-on)"
    try:
        apply(m)
    except BaseException:
        if j:
            boot_undo(j)
            j["state"] = "rolled back"
            save(BOOT_JOURNAL, j)
        raise
    if left:
        said += " (" + "; ".join(left) + ")"
    # The card image level the new version wants, reached by the bundle's kernel and U-Boot now on the card
    try:
        text = _read_text(IMAGE_REQUIRED)
        need, have = image_required(text)[0], image_level()
        route = boot_route(text, have, need) if need > have else None
        if route:
            sd_card_check()
            same = boot_same(m.get("boot") or {})
            if all(same[part] for part in route):
                set_boot_level(need)
    except Exception:
        pass
    if j and kernel:
        try:
            j["pruned"] = prune_modules({running_release(), j["card_before"], j["card_after"]})
            save(BOOT_JOURNAL, j)
        except Exception:
            pass
    save(LAST, {"result": "installed", "version": m["version"], "when": time.time()})
    if j:
        poweron_wanted((["the kernel"] if kernel else []) + (["U-Boot"] if uboot else []))
    progress("done")
    if reboot:
        reboot_radio()                  # the radio restarted: the card's parts start too, no power-on to ask for
        try:
            os.remove(POWERON)
        except OSError:
            pass
        return f"ok {m['version']}{note}{said} (the radio restarts)"
    restart_apps()
    return f"ok {m['version']}{note}{said}"


def poweron_wanted(what):
    """A power-on asked for: what (["the kernel", "U-Boot"]) waits on the SD card for the next start"""
    try:
        boot = _read(BOOT_ID).strip()
    except Exception:
        boot = ""
    save(POWERON, {"boot_id": boot, "what": " and ".join(what), "when": time.time()})


def cmd_bundle_info(args):
    """What a downloaded bundle carries for the SD card, for the question before it is applied: its version, and
    whether its kernel set and its U-Boot differ from the card's own (kernel, uboot). Both false when the radio did
    not start from an SD card: nothing would be written there"""
    if not args:
        raise Fail("bundle-info needs the bundle's path")
    m, text = bundle_manifest(args[0], image=True)
    b = boot_section(m)
    out = {"version": m["version"], "sd": True, "kernel": False, "uboot": False,
           "kernel_release": str((b.get("kernel") or {}).get("release", "")),
           "need_kernel": False, "need_uboot": False, "image_needed": False}
    # The card image level the bundle's version wants: its kernel and U-Boot may reach it ("need_..."), or not
    need, have = image_required(text)[0] if text else 1, image_level()
    route = boot_route(text, have, need) if need > have else set()
    try:
        sd_card_check()
    except Fail:
        out["sd"] = False
        out["image_needed"] = need > have
        return out
    same = boot_same(b)
    for part in BOOT_PARTS:
        out[part] = bool(b.get(part)) and not same[part]
    if route is None or any(not b.get(part) for part in route):
        out["image_needed"] = True
    else:
        out["need_kernel"], out["need_uboot"] = "kernel" in route and out["kernel"], "uboot" in route and out["uboot"]
    return out


def cmd_boot_rollback(args):
    """The kernel set, its modules and U-Boot that the last install --kernel/--uboot replaced, back on the SD card,
    from the next power-on (nothing here reboots)"""
    j = load(BOOT_JOURNAL)
    if not j or j.get("state") != "done":
        raise Fail("no kernel or U-Boot install to go back from")
    sd_card_check()
    boot_undo(j)
    j["state"] = "rolled back"
    save(BOOT_JOURNAL, j)
    if "level_before" in j:
        set_boot_level(j["level_before"])
    poweron_wanted(["the kernel and U-Boot from before"])
    return "ok the kernel and U-Boot before are back on the SD card: from the next power-on"


def cmd_upgrade(args):
    flags = [a for a in args if a.startswith("--")]
    if any(f not in ("--kernel", "--uboot", "--reboot") for f in flags) or len(flags) != len(args):
        raise Fail("upgrade takes --kernel, --uboot and --reboot")
    c = cmd_check([])
    if not c["newer"]:
        return "ok up to date" if c["latest"] else "ok no release"
    bundle = cmd_download([c["url"]])
    return cmd_install([bundle] + flags)


def cmd_rollback(args):
    journal = load(JOURNAL)
    if not journal or journal.get("state") == "rolled back":
        raise Fail("nothing to roll back")
    note = funnel_off_before(journal.get("from"), "not gone back")   # before any file goes back (#58)
    undo(journal)
    journal["state"] = "rolled back"
    save(JOURNAL, journal)
    if os.path.exists(PENDING):
        os.remove(PENDING)
    save_rollback(journal.get("version"), journal.get("from"), "hand")
    restart_apps()
    return f"ok back to {journal.get('from')}{note}"


def cmd_confirm(args):
    if os.path.exists(PENDING):
        pend = load(PENDING, {})
        os.remove(PENDING)
        journal = load(JOURNAL)
        if journal:
            journal["state"] = "confirmed"
            save(JOURNAL, journal)
        save(LAST, {"result": "confirmed", "version": pend.get("version"), "when": time.time()})
        return f"ok {pend.get('version')} confirmed"
    return "ok nothing pending"


def cmd_boot_check(args):
    # The SD card's kernel or U-Boot being written when the power went (the radio started all the same): put back
    # what the card had, so the next start is the one it was before
    bj = load(BOOT_JOURNAL)
    if bj and bj.get("state") == "applying":
        try:
            sd_card_check()
            boot_undo(bj)
        except Fail:
            pass
        bj["state"] = "rolled back"
        save(BOOT_JOURNAL, bj)
    journal = load(JOURNAL)
    if journal and journal.get("state") == "applying":   # power went during the swap
        undo(journal)
        journal["state"] = "rolled back"
        save(JOURNAL, journal)
        if os.path.exists(PENDING):
            os.remove(PENDING)
        save_rollback(journal.get("version"), journal.get("from"), "interrupted")
        return "rolled back: interrupted install"
    pend = load(PENDING)
    if not pend:
        return "ok"
    pend["starts"] = int(pend.get("starts", 0)) + 1
    if pend["starts"] > MAX_STARTS:
        funnel_off_quietly(pend.get("from"))
        if journal:
            undo(journal)
            journal["state"] = "rolled back"
            save(JOURNAL, journal)
        os.remove(PENDING)
        # A GUI that came up on the defaults because it could not use the settings file said so (fault): it was
        # never confirmed, but it did not die
        if pend.get("fault") == "settings":
            save_rollback(pend.get("version"), pend.get("from"), "settings")
        else:
            save_rollback(pend.get("version"), pend.get("from"), "starts", starts=MAX_STARTS)
        return f"rolled back to {pend.get('from')}"
    save(PENDING, pend)
    return f"pending {pend.get('version')} start {pend['starts']}"


def cmd_fault(args):
    """The pending version's GUI could not use the settings file (params/db.c, database_version_fault): it runs on
    the defaults and is not confirmed, and the step back after MAX_STARTS starts says why"""
    if args != ["settings"]:
        raise Fail("fault takes: settings")
    pend = load(PENDING)
    if not isinstance(pend, dict):
        return "ok nothing pending"
    if pend.get("fault") != "settings":
        pend["fault"] = "settings"
        save(PENDING, pend)
    return f"ok {pend.get('version')} could not use the settings file"


def cmd_notice(args):
    """What the GUI says once at its start: the last step back, until it has been said, in two short lines for its
    message box (screen_text). The mark goes into last.json, which the next install replaces"""
    last = last_state()
    if not last or last.get("result") != "rolled back" or last.get("shown"):
        return "ok"
    last["shown"] = time.time()
    save(LAST, last)
    return f"ok {screen_text(last)}"


def cmd_status(args):
    try:
        with open(PROGRESS) as f:
            prog = f.read().strip()
    except OSError:
        prog = ""
    bj = load(BOOT_JOURNAL) or {}
    return {"running": running_version(), "pending": load(PENDING), "last": last_state(), "progress": prog,
            "image": image_state(),
            "boot": {"state": bj.get("state"), "version": bj.get("version"), "when": bj.get("started"),
                     "kernel": bool(bj.get("kernel")), "release": bj.get("card_after"),
                     "uboot": (bj.get("uboot") or {}).get("state")} if bj else None}


def take_lock():
    """The staging, the previous files and the journal are one set of state: a second updater
    (the browser while the GUI installs, the start loop's boot-check) waits for the first, and
    gives up with "busy" after LOCK_WAIT seconds. Held until this process exits (audit A20)."""
    os.makedirs(STATE, exist_ok=True)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    for _ in range(LOCK_WAIT * 2 + 1):
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            time.sleep(0.5)
    raise Fail("busy: another update is running")


def main(argv):
    cmds = {"status": cmd_status, "check": cmd_check, "download": cmd_download, "install": cmd_install,
            "upgrade": cmd_upgrade, "rollback": cmd_rollback, "confirm": cmd_confirm, "boot-check": cmd_boot_check,
            "fault": cmd_fault, "notice": cmd_notice, "bundle-info": cmd_bundle_info,
            "boot-rollback": cmd_boot_rollback}
    if not argv or argv[0] not in cmds:
        print("error usage: x6100-update " + "|".join(cmds))
        return 1
    signal.signal(signal.SIGALRM, lambda *_: (print("error timed out"), sys.exit(1)))
    signal.alarm(RUN_LIMIT)
    try:
        if argv[0] not in ("status", "check"):     # the two that change nothing
            take_lock()
        out = cmds[argv[0]](argv[1:])
        print(json.dumps(out) if isinstance(out, dict) else out)
        return 0
    except Fail as e:
        print(f"error {e}")
    except Exception as e:
        print(f"error {' '.join(str(e).split())[:120] or type(e).__name__}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
