#!/bin/sh
# btgps-ctl set MAC [CHANNEL] | off | status | run
#
# A Bluetooth GPS for gpsd (an NMEA receiver on the Serial Port Profile, such as
# Garmin's GLO 2), beside Bluetooth CAT. btcat is a serial port of the radio's
# that phones and PCs connect to; a GPS is the other way round, a serial port of
# its own that the radio connects to, so the two run at once. The GPS is paired
# in Settings > Bluetooth first; "set" makes it gpsd's, "off" lets it go.
#
# "run" (started by S94btcat) keeps it: btgps-bridge connects to the GPS and gives
# its words a pseudo-terminal, given to gpsd (gpsdctl add) while it is connected and
# taken back when it drops; a GPS switched off or out of range is tried again every
# 10 s, so nothing is done by hand when it comes back. Not "rfcomm connect": this
# kernel makes no RFCOMM TTYs ("Can't create RFCOMM TTY: Operation not supported",
# the first GPS here, a GLO 2, 2026-11-18). gpsd quits a few seconds after its last
# device goes while nothing reads it (this image's): started again with the next
# connection.
CONF=/mnt/btcat.conf
LINK=/var/run/btgps.tty		# btgps-bridge's: a symlink to the pty while connected
PIDF=/var/run/btgps.pid
STATE=/tmp/btgps.state		# connected | trying | off, for the GUI and the web page
BTGPS_MAC=
BTGPS_CH=1

load() {
	BTGPS_MAC=
	BTGPS_CH=1
	[ -r $CONF ] && eval "$(grep -E '^BTGPS_(MAC|CH)=' $CONF)"
}

set_kv() {
	touch $CONF
	if grep -q "^$1=" $CONF; then
		sed -i "s/^$1=.*/$1=$2/" $CONF
	else
		echo "$1=$2" >> $CONF
	fi
	sync
}

log() { echo "$(date '+%H:%M:%S') $*"; }

# a wait a TERM ends at once (a plain sleep holds the trap till it is over)
nap() {
	sleep "$1" &
	wait $!
}

# the keeper running now ended, waited for (up to 3 s)
end_keeper() {
	p=$(cat $PIDF 2>/dev/null)
	[ -n "$p" ] || return 0
	kill "$p" 2>/dev/null
	i=0
	while [ $i -lt 30 ] && kill -0 "$p" 2>/dev/null; do
		usleep 100000
		i=$((i + 1))
	done
	rm -f $PIDF
}

gpsd_up() {
	pidof gpsd >/dev/null || /etc/init.d/S50gpsd start >/dev/null 2>&1
}

keep() {
	echo $$ > $PIDF
	trap 'kill $pid 2>/dev/null; [ -n "$tty" ] && gpsdctl remove $tty >/dev/null 2>&1; echo off > $STATE
	      [ "$(cat $PIDF 2>/dev/null)" = "$$" ] && rm -f $PIDF; exit 0' TERM INT
	while :; do
		load
		if [ -z "$BTGPS_MAC" ]; then
			echo off > $STATE
			nap 5
			continue
		fi
		mac=$BTGPS_MAC
		tty=
		echo trying > $STATE
		rm -f $LINK
		/usr/sbin/btgps-bridge "$mac" "$BTGPS_CH" $LINK &	# says why it ends in the log
		pid=$!
		i=0
		while [ $i -lt 25 ] && [ ! -e $LINK ] && kill -0 $pid 2>/dev/null; do
			nap 1
			i=$((i + 1))
		done
		if [ -e $LINK ] && kill -0 $pid 2>/dev/null; then
			tty=$(readlink $LINK)		# the pty itself: gpsd keeps the name it was given
			gpsd_up
			gpsdctl add $tty >/dev/null 2>&1
			echo connected > $STATE
			log "connected to $mac (channel $BTGPS_CH), $tty to gpsd"
			while kill -0 $pid 2>/dev/null; do
				nap 5
				load
				[ "$BTGPS_MAC" = "$mac" ] || break		# another GPS chosen, or off
				gpsd_up					# gpsd quit, or restarted without it (a USB
				gpsdctl add $tty >/dev/null 2>&1		# GPS's restart_gpsd): in again; an add
			done						# of one it has does nothing
			gpsdctl remove $tty >/dev/null 2>&1
			log "$mac gone"
		fi
		kill $pid 2>/dev/null
		wait $pid 2>/dev/null
		tty=
		echo trying > $STATE
		load
		[ "$BTGPS_MAC" = "$mac" ] && nap 10		# off or out of range: again in a while
	done
}

case "$1" in
	set)
		mac=$(echo "$2" | tr 'a-f' 'A-F')
		echo "$mac" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || { echo "not a Bluetooth address: $2"; exit 1; }
		ch=$3
		if [ -z "$ch" ]; then		# the GPS's own record says its channel, when it answers now
			ch=$(sdptool search --bdaddr "$mac" SP 2>/dev/null | sed -n 's/.*Channel: \([0-9]*\).*/\1/p' | head -n 1)
		fi
		case "$ch" in ''|*[!0-9]*) ch=1;; esac
		bluetoothctl trust "$mac" >/dev/null 2>&1	# it reconnects without asking
		set_kv BTGPS_MAC "$mac"
		set_kv BTGPS_CH "$ch"
		echo "GPS $mac, channel $ch";;
	off)
		set_kv BTGPS_MAC ""
		echo "GPS off";;
	status)
		load
		echo "BTGPS_MAC=$BTGPS_MAC"
		echo "BTGPS_CH=$BTGPS_CH"
		echo "STATE=$(cat $STATE 2>/dev/null || echo off)";;
	run)
		end_keeper
		keep;;
	stop)
		end_keeper;;
	*) echo "Usage: $0 {set MAC [CHANNEL]|off|status|run|stop}"; exit 1;;
esac
