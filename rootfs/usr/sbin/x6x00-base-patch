#!/usr/bin/env python3
"""
x6x00-base-patch: GoldCorpHF's fixes put into Xiegu's own base firmware file on the radio. GoldCorpHF ships no base:
a patch (/usr/share/x6100/base_patches/*.json) holds only the 16-byte blocks of the encrypted .xgf that change, Xiegu's
and its own (AES-ECB encrypts each block alone, so no key is needed here and nothing of Xiegu's is readable in it),
with the SHA-256 and MD5 of Xiegu's file it applies to and of the result (format 2: blocks past the end of Xiegu's
file, with no "from", are appended: code GoldCorpHF adds). Nothing is written unless Xiegu's file is
exactly the one the patch names and the result exactly the one it promises; the result goes to the base with
x6x00-base-flash, as any base file does.

    x6x00-base-patch list                         the patches here, and whether Xiegu's file for each is at hand
    x6x00-base-patch check FILE                   which known file FILE is: Xiegu's source of a patch, or a result
    x6x00-base-patch apply [NAME|PATCH] [SRC] [OUT]
                                                  NAME's result made from SRC (default: Xiegu's file found in
                                                  /mnt/base_update or /usr/firmware) into OUT (default: next to it,
                                                  the result's own name); exit 0 only with the promised SHA-256

Xiegu's X6100 V1.1.9 file is on the radio's internal memory (/usr/firmware of Xiegu's own system) and in Xiegu's
V1.2.0 update; tools/base_update/README.md says how it is found and how the patches are made (x6100_patch.py).
SPDX-License-Identifier: LGPL-2.1-or-later
"""
import glob, hashlib, json, os, sys

PATCH_DIRS = ["/usr/share/x6100/base_patches",
              os.path.join(os.path.dirname(os.path.abspath(__file__)), "../share/x6100/base_patches")]
SEARCH = ["/mnt/base_update", "/usr/firmware", "/tmp/base_update", "."]
FORMATS = ("x6x00-base-patch 1", "x6x00-base-patch 2")


def patches():
    seen, out = set(), []
    for d in PATCH_DIRS:
        for p in sorted(glob.glob(os.path.join(d, "*.json"))):
            try:
                doc = json.load(open(p))
            except (OSError, ValueError):
                continue
            if doc.get("format") in FORMATS and doc.get("name") not in seen:
                seen.add(doc["name"])
                out.append((p, doc))
    return out


def sums(path):
    b = open(path, "rb").read()
    return len(b), hashlib.sha256(b).hexdigest(), hashlib.md5(b).hexdigest()


def find_source(doc):
    want = doc["source"]["sha256"]
    for d in SEARCH:
        for f in sorted(glob.glob(os.path.join(d, "*.xgf"))):
            try:
                if os.path.getsize(f) == doc["source"]["size"] and sums(f)[1] == want:
                    return f
            except OSError:
                pass
    return None


def apply(doc, src, out):
    data = bytearray(open(src, "rb").read())
    size, sha, md5 = len(data), hashlib.sha256(data).hexdigest(), hashlib.md5(data).hexdigest()
    s = doc["source"]
    if (size, sha, md5) != (s["size"], s["sha256"], s["md5"]):
        sys.exit(f"{src} is not {s['file']} ({s['version']}): size {size}, sha256 {sha}; nothing written")
    if doc.get("format") not in FORMATS:
        sys.exit(f"a patch of format {doc.get('format')!r}: this x6x00-base-patch knows {', '.join(FORMATS)}")
    for blk in sorted(doc["blocks"], key=lambda b: b["offset"]):
        o, new = blk["offset"], bytes.fromhex(blk["to"])
        if len(new) != 16 or o % 16:
            sys.exit(f"block at {o}: not a 16-byte block; nothing written")
        if "from" not in blk:                   # appended (format 2): right at the end so far
            if doc["format"] == FORMATS[0] or o != len(data):
                sys.exit(f"block at {o}: an appended block not at the end ({len(data)}); nothing written")
            data += new
            continue
        if o + 16 > s["size"] or bytes(data[o:o + 16]) != bytes.fromhex(blk["from"]):
            sys.exit(f"block at {o}: not as the patch expects; nothing written")
        data[o:o + 16] = new
    r = doc["result"]
    if (len(data), hashlib.sha256(data).hexdigest(), hashlib.md5(data).hexdigest()) != (r["size"], r["sha256"], r["md5"]):
        sys.exit("patched, it is not the promised result (sha256 differs); nothing written")
    tmp = out + ".part"
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, out)
    print(f"{out}: {r['version']}, {r['size']} bytes, sha256 {r['sha256']} (from {s['file']}, {len(doc['blocks'])} "
          f"blocks changed)")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip().split("\n\n")[1])
        return
    ps = patches()
    if a[0] == "list":
        for p, d in ps:
            src = find_source(d)
            print(f"{d['name']}: {d['model']}, {d['result']['version']}: {d['about']}\n"
                  f"   needs {d['source']['file']} (sha256 {d['source']['sha256'][:16]}...): "
                  f"{src or 'not found here'}\n   makes {d['result']['file']} (sha256 {d['result']['sha256']})")
        if not ps:
            print("no patches here")
    elif a[0] == "check" and len(a) == 2:
        size, sha, md5 = sums(a[1])
        for p, d in ps:
            for role in ("source", "result"):
                if d[role]["sha256"] == sha and d[role]["size"] == size:
                    print(f"{a[1]}: {d[role]['version']}, the {role} of patch {d['name']}")
                    return
        print(f"{a[1]}: not a file of any patch here (sha256 {sha})")
        sys.exit(1)
    elif a[0] == "apply":
        sel = a[1] if len(a) > 1 else None
        if sel and sel.endswith(".json"):
            doc = json.load(open(sel))
        else:
            cand = [d for p, d in ps if sel in (None, d["name"])]
            if len(cand) != 1:
                sys.exit("say which patch: " + ", ".join(d["name"] for p, d in ps))
            doc = cand[0]
        src = a[2] if len(a) > 2 else find_source(doc)
        if not src:
            sys.exit(f"Xiegu's {doc['source']['file']} not found in {', '.join(SEARCH)}: copy it to /mnt/base_update")
        out = a[3] if len(a) > 3 else os.path.join(os.path.dirname(os.path.abspath(src)) if os.access(
            os.path.dirname(os.path.abspath(src)), os.W_OK) else "/mnt/base_update", doc["result"]["file"])
        apply(doc, src, out)
    else:
        sys.exit("usage: x6x00-base-patch list | check FILE | apply [NAME|PATCH.json] [SRC] [OUT]")


if __name__ == "__main__":
    main()
