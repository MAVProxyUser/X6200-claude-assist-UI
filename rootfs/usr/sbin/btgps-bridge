#!/usr/bin/env python3
# btgps-bridge MAC CHANNEL LINK
#
# A Bluetooth GPS's serial port (RFCOMM) onto a pseudo-terminal for gpsd, for btgps-ctl. This kernel has no RFCOMM
# TTYs ("rfcomm connect": "Can't create RFCOMM TTY: Operation not supported", found with a Garmin GLO 2 on
# 2026-11-18), so the link is a socket here and gpsd reads the pty's other end. LINK is made a symlink to that end
# once connected (gpsd reads as nobody: the pty is world readable) and goes when the bridge ends. The GPS's words
# go to the pty as they come; while nothing reads them (gpsd not there yet, or gone) they are dropped, never held up.
# What gpsd writes (its probes) goes back to the GPS. Ends when the GPS goes: its link dropped, or no word from it
# in SILENT_S (a GPS speaks every second): exit 1; refused or not there: exit 2; on TERM: exit 0.
#
# SPDX-License-Identifier: LGPL-2.1-or-later
import errno
import os
import select
import signal
import socket
import sys
import tty

SILENT_S = 15


def say(text):
    print(f"btgps-bridge: {text}", file=sys.stderr, flush=True)


def main():
    if len(sys.argv) != 4:
        say("usage: btgps-bridge MAC CHANNEL LINK")
        return 2
    mac, ch, link = sys.argv[1], int(sys.argv[2]), sys.argv[3]
    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
    s.settimeout(20)
    try:
        s.connect((mac, ch))
    except OSError as e:
        say(f"{mac} channel {ch}: {e.strerror or e}")
        return 2
    s.setblocking(False)
    master, slave = os.openpty()            # the slave kept open here: no EIO on the master while gpsd is away
    tty.setraw(slave)
    os.set_blocking(master, False)
    name = os.ttyname(slave)
    os.chmod(name, 0o666)
    tmp = link + ".new"
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    os.symlink(name, tmp)
    os.replace(tmp, link)
    say(f"{mac} channel {ch} on {name}")
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    dropped = 0
    try:
        while True:
            r, _, _ = select.select([s, master], [], [], SILENT_S)
            if not r:
                say(f"nothing from {mac} in {SILENT_S} s: gone")
                return 1
            if s in r:
                try:
                    d = s.recv(4096)
                except OSError as e:
                    if e.errno in (errno.EAGAIN, errno.EINTR):
                        continue
                    say(f"{mac}: {e.strerror or e}")
                    return 1
                if not d:
                    say(f"{mac} closed the link")
                    return 1
                try:
                    os.write(master, d)
                except BlockingIOError:     # nobody reads the pty: dropped
                    dropped += 1
                    if dropped in (1, 1000):
                        say("gpsd is not reading: the GPS's words dropped meanwhile")
            if master in r:
                try:
                    d = os.read(master, 4096)
                except (BlockingIOError, InterruptedError):
                    continue
                except OSError:
                    continue
                if d:
                    try:
                        s.sendall(d)
                    except BlockingIOError:
                        pass
                    except OSError as e:
                        say(f"{mac}: {e.strerror or e}")
                        return 1
    finally:
        try:
            if os.path.islink(link) and os.readlink(link) == name:
                os.unlink(link)
        except OSError:
            pass
        s.close()


if __name__ == "__main__":
    sys.exit(main())
