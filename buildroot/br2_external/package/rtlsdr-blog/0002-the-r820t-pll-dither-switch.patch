From: Kevin Finisterre <kfinisterre@KevinsMacStudio.localdomain>
Subject: [PATCH] rtlsdr_set_dithering: the R820T/R828D PLL's dither switch

The R820T's PLL dithers its sigma-delta modulator (register 0x12 bit 4
clear, the default). Each tuner then wanders on its own, so receivers on
one clock lose their phase to each other: on the X6200 a KrakenSDR's
bearing swept the whole circle every 3 s with the dither on, and stayed
within 0.6 degrees for 30 s with it off (2026-11-17). New call
rtlsdr_set_dithering(dev, 0) sets the bit (the next tuning writes it, and
the call tunes again to the same frequency); the default is unchanged, so
every other user of the library behaves as before. The register's meaning
is the R820T's (KrakenRF's librtlsdr has the same switch); no code taken.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/include/rtl-sdr.h b/include/rtl-sdr.h
--- a/include/rtl-sdr.h
+++ b/include/rtl-sdr.h
@@ -407,6 +407,17 @@
  */
 RTLSDR_API int rtlsdr_set_bias_tee_gpio(rtlsdr_dev_t *dev, int gpio, int on);
 
+/*!
+ * The R820T/R828D PLL's sigma-delta dither on (the default) or off. Off for
+ * receivers that must keep their phase to each other (a KrakenSDR). It takes
+ * effect at once (the tuner is tuned again to the same frequency).
+ *
+ * \param dev the device handle given by rtlsdr_open()
+ * \param dither 1 on, 0 off
+ * \return -1 if not an R820T/R828D tuner or the device is not initialized, 0 otherwise
+ */
+RTLSDR_API int rtlsdr_set_dithering(rtlsdr_dev_t *dev, int dither);
+
 RTLSDR_API int rtlsdr_check_dongle_model(void *dev, char *manufact_check, char *product_check);
 
 #ifdef __cplusplus
diff --git a/include/tuner_r82xx.h b/include/tuner_r82xx.h
--- a/include/tuner_r82xx.h
+++ b/include/tuner_r82xx.h
@@ -84,6 +84,7 @@
 	uint8_t				fil_cal_code;
 	uint8_t				input;
 	int				has_lock;
+	int				no_dither;	/* the PLL's sigma-delta dither off (reg 0x12 bit 4) */
 	int				init_done;
 
 	/* Store current mode */
@@ -115,6 +116,7 @@
 int r82xx_standby(struct r82xx_priv *priv);
 int r82xx_init(struct r82xx_priv *priv);
 int r82xx_set_freq(struct r82xx_priv *priv, uint32_t freq);
+int r82xx_set_dither(struct r82xx_priv *priv, int dither);
 int r82xx_set_gain(struct r82xx_priv *priv, int set_manual_gain, int gain);
 int r82xx_set_bandwidth(struct r82xx_priv *priv, int bandwidth,  uint32_t rate);
 int r82xx_toggle_test(struct r82xx_priv *priv, int toggle);
diff --git a/src/tuner_r82xx.c b/src/tuner_r82xx.c
--- a/src/tuner_r82xx.c
+++ b/src/tuner_r82xx.c
@@ -513,13 +513,17 @@
 	if (rc < 0)
 		return rc;
 
-	/* pw_sdm */
+	/* pw_sdm; bit 4 switches the sigma-delta's dither off (a coherent
+	 * receiver such as the KrakenSDR's five wants it off: with it on each
+	 * tuner's PLL wanders on its own) */
 	if (!vco_fra)
 		val = 0x08;
 	else
 		val = 0x00;
+	if (priv->no_dither)
+		val |= 0x10;
 
-	rc = r82xx_write_reg_mask(priv, 0x12, val, 0x08);
+	rc = r82xx_write_reg_mask(priv, 0x12, val, 0x18);
 	if (rc < 0)
 		return rc;
 
@@ -1149,6 +1153,13 @@
 #undef FILT_HP_BW1
 #undef FILT_HP_BW2
 
+/* The PLL's dither on (the default) or off; the next tuning writes it */
+int r82xx_set_dither(struct r82xx_priv *priv, int dither)
+{
+	priv->no_dither = !dither;
+	return 0;
+}
+
 int r82xx_set_freq(struct r82xx_priv *priv, uint32_t freq)
 {
 	int rc = -1;
diff --git a/src/librtlsdr.c b/src/librtlsdr.c
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -2172,4 +2172,12 @@
 int rtlsdr_set_bias_tee(rtlsdr_dev_t *dev, int on)
 {
 	return rtlsdr_set_bias_tee_gpio(dev, 0, on);
+}
+
+int rtlsdr_set_dithering(rtlsdr_dev_t *dev, int dither)
+{
+	if (!dev || (dev->tuner_type != RTLSDR_TUNER_R820T && dev->tuner_type != RTLSDR_TUNER_R828D))
+		return -1;
+	r82xx_set_dither(&dev->r82xx_p, dither);
+	return dev->freq ? rtlsdr_set_center_freq(dev, dev->freq) : 0;
 }
